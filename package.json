  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prerender": "tsc && vite build && node scripts/write-prerender-routes.mjs && vite build --config vite.ssr.config.ts --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
